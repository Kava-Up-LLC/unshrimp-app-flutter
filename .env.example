# Unshrimp reads its AppAmbit App Key from a compile-time define, NOT the bundle.
# This file only documents that define; it is no longer loaded by the app.
#
# Pass the key when you run or build:
#
#   flutter run --dart-define=APPAMBIT_APP_KEY=your-app-key
#
# Or keep per-environment keys in dart_defines/*.json (the folder is gitignored)
# and pass the file:
#
#   flutter run --dart-define-from-file=dart_defines/dev.json
#
# where dart_defines/dev.json is:
#
#   { "APPAMBIT_APP_KEY": "your-app-key" }
#
# Create one AppAmbit app per platform (iOS and Android) and use that platform's
# app key for its build. With no key, the app shows a "Missing App Key" screen
# instead of starting.
